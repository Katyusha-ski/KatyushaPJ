  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter3MansionIntro_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "(ngó quanh) Nè Kati, trong căn biệt thự này nồng nặc mùi quỷ. Có thể số lượng còn đông hơn tụi chúng ta đã xử nãy giờ"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Hả? Nơi nhỏ như này mà còn đông quỷ hơn sao?"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Tôi không rõ nhưng trước đây tôi đã từng nghe qua về căn biệt thự và căn hầm của nơi đây. Có thể nó sâu và rộng hơn vẻ bề ngoài rất nhiều đó."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Ngạc nhiên thật. Thôi ta cũng vào thôi."
