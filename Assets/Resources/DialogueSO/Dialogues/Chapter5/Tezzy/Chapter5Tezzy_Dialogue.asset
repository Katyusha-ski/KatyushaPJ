%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter5Tezzy_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Hù :))"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "??????"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Cái này là trò đùa kiểu mới hả? Chắc tôi nên ra ngoài giao tiếp nhiều hơn."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Nè, hai đứa bây đừng có coi thường ta vậy chứ. Ta là một Shakiza vô cùng quyền năng đó, có thể cho hai đứa bây về \"các bụi\"."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Nè Hachi, con cá này đang nói gì vậy?"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Hmmm... Shakiza là một giống loài khác với hai phe sinh vật sống và quỷ. Chúng vốn tới từ không gian gọi chung là \"The Outside\"."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Vào thời kỳ đại chiến giữa chúng tôi và quỷ thì mọi thứ hỗn loạn đến mức mở ra các cổng không gian từ The Outside."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Và có những sinh vật từ The Outside cũng đã tiến vào đây, ta có thể coi họ là phe trung lập. Một số người đã chọn ở lại nơi này sau khi cuộc đại chiến kết thúc nên chúng tôi gọi họ là Shakiza."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Hahaha, kẻ này cũng hiểu biết đấy chứ. Nếu thế thì mau sợ hãi ta đi. Ta mạnh lắm đó."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Giờ tôi phải làm sao đây Hachi."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Ờ thì đúng là Shakiza cũng mang rất nhiều sức mạnh lớn, nhưng mà kẻ này thì tôi thấy hắn rất yếu."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Nè tên đáng ghét kia, ta là Tezzy, Tezzy the Emperor. Kẻ như ngươi dám xem thường ta hả? ヽ(`Д´)ノ"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Nè hắn ồn ào quá -_- Chúng ta chặn hắn được không."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Ôi đại ca, tôi xin lỗi. Đừng đánh tôi huhu, tôi có vũ khí xịn sẽ trao đổi với hai cậu. Xin đừng đánh tôi mà."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Thiệt hả? Vậy thì tuyệt quá."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Đúng vậy. Hai người đã đánh bại hai con golem đó đúng không. Tôi rất là biết ơn hai vị đó. Bọn chúng không biết nói lý lẽ chút nào T_T"
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Mà bọn chúng có rơi rớt món gì quý giá không vậy. Tôi rất là muốn xem đó."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Ờ thì có đây."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Hô hố, thứ này đúng là đỉnh cao. Nếu hai vị có thể trao đổi với tôi thứ này thì tôi sẽ cho hai vị bảo kiếm vô cùng xịn xò."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Thế thì tuyệt quá. Đồ của cậu đây, dù sao thì tôi cũng không biết làm gì với thứ này."
  - speaker: {fileID: 11400000, guid: 93f3f3f3f3f34f3f8f3f3f3f3f3f3f31, type: 2}
    text: "Hehehehe, cảm ơn hai vị rất nhiều."
