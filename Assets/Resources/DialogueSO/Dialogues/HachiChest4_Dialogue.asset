  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: HachiChest4_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: 'Ừm... nhìn cũng bình thường mà? Đâu tệ như cậu tả.'
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: 'Cậu đâu cảm nhận được ma lực, chỉ mình tôi thấy thôi — vẫn còn dư vị ghê ghê trong không khí này, nhưng đỡ hơn nhiều so với thủ đô rồi. Ít ra vùng này chưa bị chiếm đóng nặng. Đi tìm người sống sót thôi!'