%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: StrangedHouse2_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 15a6c98b59ae4afea97487223c929705, type: 2}
    text: "L\xE0 qu\u1EF7 sao?! Huhu m\u1EB9 \u01A1i, con s\u1EAFp ch\u1EBFt r\u1ED3i!"
  - speaker: {fileID: 11400000, guid: ddb92e141eae46898509938b09c7140d, type: 2}
    text: "Kh\xF4ng ph\u1EA3i \u0111\xE2u, c\u1EADu \u1EA5y kh\xF4ng ph\u1EA3i qu\u1EF7,
      c\u1EADu \u1EA5y c\xF9ng gi\u1ED1ng lo\xE0i v\u1EDBi ch\xFAng ta \u0111\u1ED3
      ng\u1ED1c \u1EA1. B\xECnh t\u0129nh l\u1EA1i \u0111i."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "T\xF4i l\xE0 Hachi, chi\u1EBFn binh ho\xE0ng gia, tuy c\xF3 nhi\u1EC1u
      chuy\u1EC7n x\u1EA3y ra khi\u1EBFn t\xF4i ch\u1EC9 c\xF2n l\u1EA1i linh h\u1ED3n
      th\xF4i nh\u01B0ng t\xF4i v\u1EABn c\xF2n s\u1EE9c m\u1EA1nh \u0111\u1EC3 gi\xFAp
      c\xE1c c\u1EADu. Tr\u01B0\u1EDBc h\u1EBFt t\xF4i c\u1EA7n bi\u1EBFt, c\xE1c
      c\u1EADu c\xF2n v\u0169 kh\xED g\xEC kh\xF4ng?"
  - speaker: {fileID: 11400000, guid: ddb92e141eae46898509938b09c7140d, type: 2}
    text: "Ng\xF4i l\xE0ng n\xE0y ch\u1EC9 l\xE0 m\u1ED9t l\xE0ng nh\u1ECF, ngu\u1ED3n
      s\u1ED1ng ch\xEDnh c\u1EE7a ch\xFAng t\xF4i d\u1EF1a v\xE0o n\xF4ng nghi\u1EC7p."
  - speaker: {fileID: 11400000, guid: ddb92e141eae46898509938b09c7140d, type: 2}
    text: "T\xF4i l\xE0 t\xEAn l\xE0 Snake, ng\u01B0\u1EDDi duy nh\u1EA5t \u1EDF
      \u0111\xE2y bi\u1EBFt m\u1ED9t ch\xFAt v\u1EC1 chi\u1EBFn \u0111\u1EA5u v\xE0
      ma thu\u1EADt. Ph\u1EA7n l\u1EDBn v\u0169 kh\xED c\u1EE7a ch\xFAng t\xF4i \u0111\u1EC1u
      r\u1EA5t th\xF4 s\u01A1, t\xF4i ch\u1EC9 c\xF3 m\u1ED9t con dao nh\u1ECF th\xF4i."
  - speaker: {fileID: 11400000, guid: 753499cfd0274996b830a0328388dfd9, type: 2}
    text: "Tuy kh\xF4ng t\u1ED1t nh\u01B0 nh\u1EEFng th\u1EE9 c\u1EADu t\u1EEBng
      s\u1EED d\u1EE5ng, nh\u01B0ng \u0111\xF3 l\xE0 v\u0169 kh\xED di\u1EC7t qu\u1EF7
      t\u1ED1t nh\u1EA5t m\xE0 ch\xFAng t\xF4i c\xF3 \u1EDF \u0111\xE2y. V\xE0 ch\xFAng
      t\xF4i c\xF2n m\u1ED9t \xEDt th\u1EE9c \u0103n n\u1EEFa, hy v\u1ECDng c\xF3
      th\u1EC3 gi\xFAp cho 2 c\u1EADu"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "C\u1EA3m \u01A1n anh. C\xF3 v\u1EBB anh l\xE0 ng\u01B0\u1EDDi d\u1EF1ng
      l\xEAn k\u1EBFt gi\u1EDBi \u0111\u1EC3 h\u1EA1n ch\u1EBF ma l\u1EF1c c\u1EE7a
      d\xE2n l\xE0ng n\xE0y \u0111\u1EC3 \u1EA9n n\u1EA5p ph\u1EA3i kh\xF4ng? Anh
      y\xEAn t\xE2m, t\xF4i s\u1EBD di\u1EC7t s\u1EA1ch b\u1ECDn ch\xFAng."
  - speaker: {fileID: 11400000, guid: 753499cfd0274996b830a0328388dfd9, type: 2}
    text: "C\u1EA3m \u01A1n c\u1EADu. T\xF4i \u0111\u1EB7t h\u1EBFt ni\u1EC1m tin
      v\xE0o c\u1EADu \u0111\u1EA5y."
