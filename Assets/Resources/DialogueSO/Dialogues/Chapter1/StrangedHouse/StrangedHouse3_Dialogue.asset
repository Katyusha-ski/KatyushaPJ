  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: StrangedHouse3_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "(gi\u1eadt m\xecnh) ...C\u1eadu v\u1eeba l\xe0m c\xe1i g\xec v\u1eady?!"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Hehe, tuy kh\xf4ng c\xf2n c\u01a1 th\u1ec3 nh\u01b0 tr\u01b0\u1edbc nh\u01b0ng b\xf9 l\u1ea1i l\xe0m \u0111\u01b0\u1ee3c tr\xf2 n\xe0y n\xe8 =))"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "(m\u1ec7t m\u1ecfi) ...Th\xf4i t\xf4i kh\xf4ng h\u1ecfi n\u1eefa. D\xf9 g\xec n\xe3y gi\u1edd th\xec c\u0169ng \u0111i\xean qu\xe1 r\u1ed3i."
