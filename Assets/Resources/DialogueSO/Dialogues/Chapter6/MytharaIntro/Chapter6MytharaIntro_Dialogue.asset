  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter6MytharaIntro_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Nơi này, yên tĩnh thật."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Ờ, khu rừng này, phải nói sao nhỉ, tôi từng luyện tập ở đây. Nhưng mà hiện tại thì tôi cảm giác nó không còn là nơi tôi từng biết nữa rồi. Khả năng là ở đây có lõi quỷ, ta phải tìm ra nó mới được."
