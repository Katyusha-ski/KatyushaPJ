%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter6UsagiGiftBefore_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: ba9e4e92a1ad5fd48a4938317a4ac0ba, type: 2}
    text: "Chào hai người, có tin tốt đây."
  - speaker: {fileID: 11400000, guid: ba9e4e92a1ad5fd48a4938317a4ac0ba, type: 2}
    text: "Quân tiếp viện từ các quốc gia đồng minh đã tới biên giới, họ đang chuẩn bị tiến vào vương quốc này theo đường mà hai người đã vẽ ra."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Vậy thì tốt quá, chúng ta có thể đỡ được phần nào rồi."
  - speaker: {fileID: 11400000, guid: ba9e4e92a1ad5fd48a4938317a4ac0ba, type: 2}
    text: "Chưa đâu, theo tôi thấy vấn đề vẫn nằm ở thủ đô. Nếu không giải quyết được nó sớm thì chúng ta phải tiêu hao rất nhiều lực lượng để giải phóng đất nước này đó."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Được rồi. Cậu còn gì mới không? Chúng tôi muốn thêm tiếp tế."
  - speaker: {fileID: 11400000, guid: ba9e4e92a1ad5fd48a4938317a4ac0ba, type: 2}
    text: "Có đây, nhưng mà lần này có hơi khác một chút. Tôi có vài thứ đặc biệt, trước hết thì các cậu có thích sự bất ngờ không?"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Hả? Bất ngờ gì cơ?"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Tất nhiên, tôi thích mấy thứ bất ngờ lắm."
  - speaker: {fileID: 11400000, guid: ba9e4e92a1ad5fd48a4938317a4ac0ba, type: 2}
    text: "Vậy thì chọn 1 đến 3 đi. Tôi sẽ cho các cậu vũ khí tùy theo con số đó."
