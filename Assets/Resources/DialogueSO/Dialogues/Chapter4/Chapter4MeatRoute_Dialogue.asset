MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter4MeatRoute_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Ôi cái đệch, b-buồn nôn quá. Cái quái gì vậy?"
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Đây là máu thịt của người và gia cầm trộn lẫn với nhau. Kinh khủng thật. Bọn chúng làm việc này để làm gì cơ chứ?"
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Huệ... Tôi không muốn biết nữa."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Hình như là lũ quỷ đang muốn lăn khối thịt này đi đâu đó. Tôi nghe nói rằng bọn chúng thường có những tập tính cung cấp máu thịt cho lõi quỷ."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Khả năng là cứ theo hướng này thì ta sẽ tìm được thôi."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Nhanh đi thôi mùi ở đây tởm quá T_T"
