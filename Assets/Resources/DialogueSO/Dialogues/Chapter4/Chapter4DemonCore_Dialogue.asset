  m_Script: {fileID: 11500000, guid: 12efb4e91f50acd42999f69a91d76dab, type: 3}
  m_Name: Chapter4DemonCore_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "(giọng run run) Nè Kati, hình như chúng ta tới rồi."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Nè cậu có chắc là chúng ta thắng được không vậy."
  - speaker: {fileID: 11400000, guid: 02a1fc921f4037d4bb7357b2fa36c700, type: 2}
    text: "Tôi không chắc nữa, đây là lần đầu tôi đối mặt với quỷ cấp cao thế này."
  - speaker: {fileID: 11400000, guid: cdfbdabbf8285304690416cec3c5c792, type: 2}
    text: "Không sao đâu dù gì chúng ta cũng đã tới đây rồi, tiến lên thôi."
